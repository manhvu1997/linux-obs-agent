        "uid": "${DS_CLICKHOUSE}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "format": 1,
          "rawSql": "SELECT ts, host, reason, verdict, length(report) AS reportBytes\nFROM obs.diagnose_snapshots\nWHERE $__timeFilter(ts) AND host IN (${host:singlequote})\nORDER BY ts DESC LIMIT 100",
