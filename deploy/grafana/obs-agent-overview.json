          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "topk(10, obs_agent_family_mem_rss_bytes{instance=~\"$instance\",family=~\"$family\"})",
          "legendFormat": "{{instance}} {{family}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
