{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus"
    }
  ],
  "uid": "obs-agent-overview",
  "title": "obs-agent Overview",
  "tags": [
    "obs-agent"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(obs_agent_cpu_usage_percent, instance)",
        "definition": "label_values(obs_agent_cpu_usage_percent, instance)",
        "multi": true,
        "includeAll": true,
        "refresh": 2
      },
      {
        "name": "family",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(obs_agent_family_cpu_percent{instance=~\"$instance\"}, family)",
        "definition": "label_values(obs_agent_family_cpu_percent{instance=~\"$instance\"}, family)",
        "multi": true,
        "includeAll": true,
        "refresh": 2
      },
      {
        "name": "chhost",
        "label": "ClickHouse host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(obs_agent_clickhouse_host_info{instance=~\"$instance\"}, host)",
        "definition": "label_values(obs_agent_clickhouse_host_info{instance=~\"$instance\"}, host)",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "hide": 2
      }
    ]
  },
  "links": [
    {
      "targetBlank": true,
      "title": "MySQL & Network Analysis (ClickHouse)",
      "type": "link",
      "url": "/d/obs-agent-analysis/obs-agent-analysis?${chhost:queryparam}&${family:queryparam}&$__url_time_range"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Node",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "",
        "uid": ""
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "obs_agent_cpu_usage_percent{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} usage"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "obs_agent_cpu_iowait_percent{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} iowait"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "obs_agent_cpu_steal_percent{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} steal"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Load (1m) and blocked tasks",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "obs_agent_load1{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} load1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "obs_agent_procs_blocked{instance=~\"$instance\"}",
          "legendFormat": "{{instance}} D-state"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory available",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
