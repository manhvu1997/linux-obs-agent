          },
          "expr": "topk(10, rate(obs_agent_mysql_digest_cpu_seconds_total{instance=~\"$instance\"}[5m]) * on (instance, digest_id) group_left (digest_text) obs_agent_mysql_digest_info{instance=~\"$instance\"})",
