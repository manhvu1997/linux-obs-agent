          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum by (instance, family, direction) (rate(obs_agent_family_net_bytes_total{instance=~\"$instance\",family=~\"$family\"}[$__rate_interval]))",
